
/* ---------- passport ---------- */
.pp-page{--ink:var(--wisteria);color:var(--cellar)}
.pp-hero{position:relative;background:var(--paper)}
.pp-wrap{max-width:1440px;margin:0 auto;box-sizing:border-box;padding:120px}
.pp-heroin{padding-top:max(190px,22vh);padding-bottom:96px}
.pp-heroin .eyebrow{margin-bottom:24px}
.pp-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px 48px}
.pp-title{font-family:var(--head);font-weight:400;text-transform:lowercase;line-height:.9;letter-spacing:-.03em;font-size:clamp(64px,13vw,220px);color:var(--wisteria)}
.pp-count{margin-bottom:12px;font-family:var(--head);text-transform:lowercase;line-height:1;letter-spacing:-.02em;font-size:clamp(32px,4.4vw,72px);color:var(--wisteria)}
.pp-empty{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-top:48px;padding:32px;background:var(--blush);color:var(--cellar)}
.pp-empty p{font-family:var(--head);text-transform:lowercase;line-height:1.1;font-size:clamp(30px,3.4vw,56px)}

.pp-dark{background:var(--cellar);color:var(--cream)}
.pp-tray-sec{background:var(--paper)}
.pp-glass-sec{background:var(--paper-deep)}
.pp-wrap>.eyebrow{margin-bottom:16px}
.pp-h2row{display:flex;align-items:flex-end;flex-wrap:wrap;gap:12px 20px;padding-bottom:24px}
.pp-h2{font-family:var(--head);font-weight:400;text-transform:lowercase;line-height:1;letter-spacing:-.02em;font-size:clamp(32px,4.4vw,72px);color:var(--wisteria)}
.pp-dark .pp-h2{color:var(--blossom)}
.pp-hint{margin-left:auto;font-size:12px;letter-spacing:.1em;text-transform:uppercase;text-align:right;color:var(--soft)}
.pp-tools{margin-left:auto;display:flex;flex-wrap:wrap;gap:8px 12px}

/* the open passport */
.pp-book{border-top:1px solid var(--hairline);padding-top:48px}
.pp-stage{position:relative;width:100%}
.pp-stage>svg{display:block;width:100%;overflow:visible}
.pp-stage text{font-family:var(--body)}
.pp-stage .pp-head{font-family:var(--head)}
.pp-pagehit{position:absolute;padding:0;margin:0;border:0;background:transparent;appearance:none;z-index:2}
.pp-pagehit:disabled{pointer-events:none}
.pp-pagehit:not(:disabled){cursor:crosshair;outline:1px dashed rgba(144,31,61,.6);outline-offset:-14px;transition:background .35s var(--ease)}
.pp-pagehit:not(:disabled):hover{background:rgba(144,31,61,.07)}
.pp-stampbtn{position:absolute;padding:0;margin:0;width:13%;border:0;background:transparent;line-height:0;mix-blend-mode:multiply;opacity:.94;cursor:pointer}
.pp-stampbtn svg{display:block;width:100%;overflow:visible;transition:transform .35s var(--ease)}
.pp-stampbtn:hover svg{transform:translateY(-3px) scale(1.04)}
.pp-stampin{animation:ppthud .6s cubic-bezier(.2,.9,.25,1.15)}
@keyframes ppthud{0%{transform:scale(1.9);opacity:0}45%{transform:scale(.94);opacity:1}72%{transform:scale(1.03)}100%{transform:scale(1);opacity:1}}
.pp-stamp text{font-family:var(--body)}
.pp-stamp .pp-scr,.pp-tray .pp-scr{font-family:'Mukta','Noto Sans Kannada','Noto Sans Malayalam','Noto Sans Bengali','Noto Sans Gujarati','Noto Sans Devanagari',sans-serif}

/* the tray of stamps */
.pp-tray{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:6px;padding:24px;background:var(--paper-deep);border-top:1px solid var(--hairline)}
.pp-cell{display:flex;flex-direction:column;align-items:center;gap:6px;width:100%;padding:8px 2px 6px;border:1px solid var(--hairline);background:transparent;color:var(--cellar);font-family:var(--body);font-size:11px;line-height:1.4;letter-spacing:.1em;text-transform:uppercase;text-align:center;cursor:pointer;transition:transform .35s var(--ease),background .35s var(--ease)}
.pp-cell:hover{transform:translateY(-4px)}
.pp-cell .st{display:block;width:100%;max-width:52px}
.pp-cell .st svg{display:block;width:100%;overflow:visible}
.pp-cell.on .st{opacity:.28}
.pp-cell.in{border-color:var(--wisteria);background:var(--paper)}
.pp-cell.in .st{transform:rotate(-6deg) scale(1.06)}
.pp-cell.lock{border-style:dashed;border-color:rgba(45,3,2,.4)}

/* saved glasses */
.pp-glasses{border-top:1px solid var(--hairline)}
.pp-none{margin-top:24px}
.pp-none a{color:var(--wisteria);text-decoration:underline;text-underline-offset:4px}
.pp-glasses ul{list-style:none;display:grid;gap:16px;margin-top:32px}
.pp-glasses li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center;padding:24px;background:var(--paper);border:1px solid var(--hairline)}
.pp-gname{font-family:var(--head);text-transform:lowercase;line-height:1.1;font-size:clamp(30px,3.4vw,56px);color:var(--wisteria)}
.pp-glasses li p+p{margin-top:8px}
.pp-gscript{font-family:var(--deva);font-size:20px;line-height:1.45}
.pp-clear{display:flex;flex-wrap:wrap;align-items:center;gap:16px 24px;margin-top:96px}
.pp-clear p{font-size:13px;color:var(--text-soft)}

@media (prefers-reduced-motion:reduce){.pp-stampin{animation:none}.pp-cell:hover,.pp-stampbtn:hover svg{transform:none}}
@media (max-width:899px){
 .pp-wrap{padding:96px 6vw}
 .pp-heroin{padding-top:150px;padding-bottom:72px}
 .pp-tray{grid-template-columns:repeat(4,minmax(0,1fr));padding:16px}
 .pp-glasses li{grid-template-columns:1fr}
 .pp-hint{margin-left:0;text-align:left}
}
